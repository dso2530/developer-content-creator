            <dependency>
                <groupId>io.developercontentcreator</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.developercontentcreator</groupId>
                <artifactId>github-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.developercontentcreator</groupId>
                <artifactId>ai-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.developercontentcreator</groupId>
                <artifactId>logging-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dso2530.starters</groupId>
                <artifactId>platform-security</artifactId>
                <version>${platform-starters.version}</version>
            </dependency>
            <dependency>
                <groupId>io.developercontentcreator</groupId>
                <artifactId>messaging-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.developercontentcreator</groupId>
                <artifactId>observability-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.developercontentcreator</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
